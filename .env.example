# ─────────────────────────────────────────────────────────────
#  nqx-mpq — environment. Copy to .env and fill secrets.
#  ALL ports live here. Change a port → change it once, here.
# ─────────────────────────────────────────────────────────────

PROJECT_NAME=nqx-mpq

# ---- Ports (host side) ----
POSTGRES_PORT=5436
REDIS_PORT=6383
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
ADMINER_PORT=8085
BACKEND_PORT=9000
STOREFRONT_PORT=8800

# ---- Postgres ----
POSTGRES_USER=mpq
POSTGRES_PASSWORD=mpq_db_pw_change_me
POSTGRES_DB=mpq

# ---- Redis ----
# (no auth on internal docker network)

# ---- MinIO (S3-compatible image storage) ----
MINIO_ROOT_USER=mpqminio
MINIO_ROOT_PASSWORD=mpq_minio_pw_change_me
MINIO_BUCKET=mpq-media

# ---- Medusa backend ----
JWT_SECRET=change_me_jwt_secret
COOKIE_SECRET=change_me_cookie_secret
MEDUSA_ADMIN_EMAIL=admin@mpq.local
MEDUSA_ADMIN_PASSWORD=AdminMPQ123!

# Public base URLs (used by storefront + admin links). Adjust host if remote.
BACKEND_PUBLIC_URL=http://localhost:9000
STOREFRONT_PUBLIC_URL=http://localhost:8800
MINIO_CONSOLE_PUBLIC_URL=http://localhost:9011
ADMINER_PUBLIC_URL=http://localhost:8085

# ---- Stripe (fill when ready; until then manual provider is used) ----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Storefront ----
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8800
# Publishable key is generated during migration/seed and printed to console.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ---- Mongo source (only for one-off migration) ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Set true on first boot to import the old MongoDB catalogue, then set back to false
RUN_DATA_MIGRATION=false
